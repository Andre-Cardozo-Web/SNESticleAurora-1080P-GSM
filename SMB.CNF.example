# SNESticle Revive: one read-only SMB share used as smb:/
# Copy this file as SMB.CNF beside the ELF, into the ISO root, or to
# mc0:/SNESticle/SMB.CNF. Use a numeric IPv4 address (no hostname).

SERVER_IP=192.168.1.100
SERVER_PORT=445
SHARE=roms
USER=GUEST
PASSWORD=
PASSWORD_TYPE=-1

# PASSWORD_TYPE=-1 : guest / no password
# PASSWORD_TYPE=0  : plaintext password (legacy; not recommended)
# PASSWORD_TYPE=1  : hash PASSWORD locally before SMB authentication
